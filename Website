            gridEl.innerHTML = ALBUMS.map((album) => `
                <article
                    class="album-card"
                    role="button"
                    tabindex="0"
                    aria-label="Open ${album.title} album (${album.photos.length} photographs)"
                    onclick="openAlbumPage('${album.id}')"
                    onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openAlbumPage('${album.id}');}"
                >
                    <img
                        class="album-card-img"
                        src="${album.cover}"
                        alt="${album.title}"
                        loading="lazy"
                        onerror="handleImageError(this, '${album.title.replace(/'/g, "\\'")}', ${album.paletteIndex}, true)"
