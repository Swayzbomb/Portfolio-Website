        /**
         * Switches cleanly to a Dedicated Album Page View (Pure DOM switching, no pushState)
         */
        function openAlbumPage(albumId) {
            const album = ALBUMS.find((a) => a.id === albumId);
            if (!album) return;

            activeAlbum = album;

            // Populate album header details
            document.getElementById('album-series-tag').textContent = album.series;
            document.getElementById('album-title').textContent = album.title;
            document.getElementById('album-description').textContent = album.description;
            document.getElementById('album-location').textContent = album.location;
            document.getElementById('album-year').textContent = album.year;
            document.getElementById('album-count').textContent = `${album.photos.length} Photographs`;

            // Render gallery grid for this album
            const galleryEl = document.getElementById('album-gallery');
            galleryEl.innerHTML = album.photos.map((photo, idx) => `
                <figure
                    class="photo-item ${photo.wide ? 'wide' : ''}"
                    role="button"
                    tabindex="0"
                    aria-label="Inspect ${photo.title} in full-screen viewer"
                    onclick="openLightbox(${idx})"
                    onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(${idx});}"
                >
                    <div class="photo-frame">
                        <img
                            src="${photo.url}"
                            alt="${photo.title}"
                            loading="lazy"
                            onerror="handleImageError(this, '${photo.title.replace(/'/g, "\\'")}', ${album.paletteIndex}, false)"
                        >
                    </div>
                    <figcaption class="photo-caption-bar">
                        <span class="photo-title">${photo.title}</span>
                        <span class="photo-specs">${photo.specs}</span>
                    </figcaption>
                </figure>
            `).join('');

            // Update bottom header active link state for this album page
            renderBottomHeader('album-bottom-header', album.id);

            // Switch visible page view
            const landingView = document.getElementById('landing-page');
            const albumView = document.getElementById('album-page');

            landingView.classList.add('hidden');
            albumView.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'instant' });
        }

        /**
         * Switches cleanly back to the Landing Page View
         */
        function showLandingPage() {
            activeAlbum = null;

            const landingView = document.getElementById('landing-page');
            const albumView = document.getElementById('album-page');

            albumView.classList.add('hidden');
            landingView.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'instant' });
        }

        /**
         * Lightbox Viewer Functions
         */
        function openLightbox(index) {
            if (!activeAlbum) return;
            lightboxIndex = index;
            updateLightboxDisplay();

            const lb = document.getElementById('lightbox');
            lb.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            const lb = document.getElementById('lightbox');
            lb.classList.remove('open');
            document.body.style.overflow = '';
        }

        function updateLightboxDisplay() {
            if (!activeAlbum) return;
            const photo = activeAlbum.photos[lightboxIndex];
            const imgEl = document.getElementById('lb-image');

            imgEl.style.opacity = '0.35';
            setTimeout(() => {
                imgEl.onerror = function() {
                    handleImageError(this, photo.title, activeAlbum.paletteIndex, false);
                };
                imgEl.src = photo.url;
                imgEl.alt = photo.title;
                document.getElementById('lb-counter').textContent = `${lightboxIndex + 1} / ${activeAlbum.photos.length}`;
                document.getElementById('lb-album-title').textContent = activeAlbum.title;
                document.getElementById('lb-title').textContent = photo.title;
                document.getElementById('lb-specs').textContent = photo.specs;
                imgEl.style.opacity = '1';
            }, 90);
        }

        function nextLightboxPhoto(event) {
            if (event) event.stopPropagation();
            if (!activeAlbum) return;
            lightboxIndex = (lightboxIndex + 1) % activeAlbum.photos.length;
            updateLightboxDisplay();
        }

        function prevLightboxPhoto(event) {
            if (event) event.stopPropagation();
            if (!activeAlbum) return;
            lightboxIndex = (lightboxIndex - 1 + activeAlbum.photos.length) % activeAlbum.photos.length;
            updateLightboxDisplay();
        }

        /**
         * Clipboard & Toast Helpers
         */
        function copyEmail() {
            const email = 'studio@visualarchive.com';
            const input = document.createElement('input');
            input.value = email;
            document.body.appendChild(input);
            input.select();
            try {
                document.execCommand('copy');
                showToast('Copied: studio@visualarchive.com');
            } catch (e) {
                showToast('Email: studio@visualarchive.com');
            }
            document.body.removeChild(input);
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('visible');

            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('visible');
            }, 2800);
        }

        // Keyboard navigation for Lightbox
        document.addEventListener('keydown', (e) => {
            const lb = document.getElementById('lightbox');
            if (!lb.classList.contains('open')) return;

            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight') nextLightboxPhoto();
            if (e.key === 'ArrowLeft') prevLightboxPhoto();
        });

        // Close Lightbox on backdrop click
        document.getElementById('lightbox').addEventListener('click', (e) => {
            if (e.target.id === 'lightbox' || e.target.classList.contains('lightbox-stage')) {
                closeLightbox();
            }
        });

        // Initialize Portfolio on Load
        document.addEventListener('DOMContentLoaded', () => {
            renderLandingAlbums();
            renderBottomHeader('landing-bottom-header', null);
            renderBottomHeader('album-bottom-header', null);
        });
