        /**
         * Safely handles image fallback using our procedural canvas generator
         */
        function handleImageError(imgElement, title, paletteIndex, isSquare) {
            imgElement.onerror = null; // Prevent infinite loop
            imgElement.src = generateArtFallback(title, paletteIndex, isSquare);
        }

        /**
         * Renders the Landing Page 1:1 Square Album Grid
