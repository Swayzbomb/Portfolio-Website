         * Procedural Fine-Art Canvas Generator
         * Generates bespoke, high-resolution, gallery-grade architectural/landscape/minimalist
         * art data-URIs on the fly whenever an external image is blocked or offline.
         */
        function generateArtFallback(title, paletteIndex, isSquare) {
            const palettes = [
                { bg1: '#2c3034', bg2: '#d8d3c8', accent: '#18191b', sun: '#f4efe6' }, // Urban Geometry
                { bg1: '#2b3a42', bg2: '#cbd5dc', accent: '#162026', sun: '#eef3f6' }, // Nordic Silence
                { bg1: '#1e1e1e', bg2: '#b8b8b8', accent: '#0e0e0e', sun: '#ececec' }, // Monochrome Portraits
                { bg1: '#364137', bg2: '#d5dcd2', accent: '#1d241e', sun: '#f2f5f0' }, // Botanical Minimal
                { bg1: '#141726', bg2: '#373e5c', accent: '#e07a5f', sun: '#f2cc8f' }, // Nocturne Neon
                { bg1: '#2f4550', bg2: '#d8e2dc', accent: '#1b2830', sun: '#f8f9fa' }  // Coastal Horizons
            ];
            const p = palettes[paletteIndex % palettes.length];
            const w = isSquare ? 800 : 1200;
            const h = isSquare ? 800 : 800;

            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');

            // Sky / Background gradient
            const grad = ctx.createLinearGradient(0, 0, 0, h);
            grad.addColorStop(0, p.bg2);
            grad.addColorStop(1, p.bg1);
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, w, h);

            // Subtle sun / light aperture
            ctx.fillStyle = p.sun;
            ctx.globalAlpha = 0.75;
            ctx.beginPath();
            ctx.arc(w * 0.68, h * 0.32, Math.min(w, h) * 0.14, 0, Math.PI * 2);
            ctx.fill();

            // Minimalist geometric horizon / architectural forms
            ctx.globalAlpha = 0.85;
            ctx.fillStyle = p.accent;
            ctx.fillRect(0, h * 0.64, w, h * 0.36);

            ctx.globalAlpha = 0.45;
            ctx.fillStyle = p.bg1;
            ctx.beginPath();
            ctx.moveTo(w * 0.12, h * 0.64);
            ctx.lineTo(w * 0.42, h * 0.28);
            ctx.lineTo(w * 0.65, h * 0.64);
            ctx.closePath();
            ctx.fill();

            // Subtle fine-art border & plate label
            ctx.globalAlpha = 0.5;
            ctx.strokeStyle = p.sun;
            ctx.lineWidth = 2;
            ctx.strokeRect(36, 36, w - 72, h - 72);

            ctx.globalAlpha = 0.85;
            ctx.fillStyle = p.sun;
            ctx.font = '500 18px Georgia, serif';
            ctx.fillText(title.toUpperCase(), 60, h - 64);

            return canvas.toDataURL('image/jpeg', 0.88);
        }

