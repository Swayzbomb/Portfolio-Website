<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VISUAL ARCHIVE — Minimalist Photography Portfolio</title>
    <style>
        /* ==========================================================================
           DESIGN TOKENS & RESET (Zero External Dependencies)
           ========================================================================== */
        :root {
            --bg-primary: #faf9f6;
            --bg-secondary: #f2f0eb;
            --bg-card: #e8e5de;
            --bg-dark: #161514;
            --bg-dark-elevated: #22201e;
            --text-primary: #181715;
            --text-secondary: #5c5852;
            --text-muted: #8c867e;
            --text-inverse: #f7f6f2;
            --text-inverse-muted: #a39e96;
            --border-light: #e2dfd7;
            --border-dark: #2e2b28;
            --accent: #181715;
            --radius-sm: 4px;
            --radius-md: 8px;
            --radius-lg: 12px;
            --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --font-serif: "Georgia", "Times New Roman", Times, serif;
            --transition-fast: 180ms cubic-bezier(0.16, 1, 0.3, 1);
            --transition-smooth: 420ms cubic-bezier(0.16, 1, 0.3, 1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            font-size: 16px;
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: var(--font-sans);
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        button {
            font-family: inherit;
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
        }

        img {
            display: block;
            max-width: 100%;
        }

        /* ==========================================================================
           LAYOUT UTILITIES
           ========================================================================== */
        .container {
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        @media (min-width: 640px) {
            .container {
                padding: 0 2.5rem;
            }
        }

        .page-view {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            opacity: 1;
            transition: opacity 250ms ease;
        }

        .page-view.hidden {
            display: none;
            opacity: 0;
        }

        .main-content {
            flex: 1 0 auto;
            padding-bottom: 5rem;
        }

        /* ==========================================================================
           LANDING PAGE HEADER
           ========================================================================== */
        .landing-header {
            padding: 4.5rem 1.5rem 3.5rem;
            text-align: center;
            max-width: 820px;
            margin: 0 auto;
        }

        @media (min-width: 768px) {
            .landing-header {
                padding: 6rem 2.5rem 4.5rem;
            }
        }

        .eyebrow {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .main-title {
            font-family: var(--font-serif);
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 400;
            letter-spacing: 0.08em;
            line-height: 1.1;
            color: var(--text-primary);
            margin-bottom: 1.25rem;
        }

        .main-subtitle {
            font-size: clamp(0.95rem, 1.5vw, 1.1rem);
            font-weight: 300;
            color: var(--text-secondary);
            max-width: 560px;
            margin: 0 auto;
            line-height: 1.7;
        }

        .header-divider {
            width: 48px;
            height: 1px;
            background-color: var(--border-light);
            margin: 2rem auto 0;
        }

        /* ==========================================================================
           SQUARE ALBUM GRID (LANDING PAGE)
           ========================================================================== */
        .albums-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.75rem;
        }

        @media (min-width: 600px) {
            .albums-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
            }
        }

        @media (min-width: 960px) {
            .albums-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 2.25rem;
            }
        }

        .album-card {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: var(--radius-md);
            overflow: hidden;
            background-color: var(--bg-card);
            cursor: pointer;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
        }

        .album-card:hover,
        .album-card:focus-visible {
            transform: translateY(-4px);
            box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12);
            outline: 2px solid var(--text-primary);
            outline-offset: 4px;
        }

        .album-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
        }

        .album-card:hover .album-card-img {
            transform: scale(1.06);
        }

        .album-card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to top,
                rgba(18, 17, 16, 0.85) 0%,
                rgba(18, 17, 16, 0.25) 48%,
                rgba(18, 17, 16, 0.12) 100%
            );
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.5rem;
            transition: background var(--transition-fast);
        }

        .album-card:hover .album-card-overlay {
            background: linear-gradient(
                to top,
                rgba(18, 17, 16, 0.92) 0%,
                rgba(18, 17, 16, 0.35) 55%,
                rgba(18, 17, 16, 0.18) 100%
            );
        }

        .album-card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .album-badge {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.92);
            background: rgba(22, 21, 20, 0.48);
            padding: 0.35rem 0.65rem;
            border-radius: var(--radius-sm);
            backdrop-filter: blur(4px);
        }

        .album-arrow {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.16);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transform: translateY(4px);
            transition: opacity var(--transition-fast), transform var(--transition-fast), background var(--transition-fast);
        }

        .album-card:hover .album-arrow {
            opacity: 1;
            transform: translateY(0);
        }

        .album-card-bottom {
            color: #ffffff;
        }

        .album-card-meta {
            font-size: 0.7rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.72);
            margin-bottom: 0.35rem;
        }

        .album-card-title {
            font-family: var(--font-serif);
            font-size: 1.65rem;
            font-weight: 400;
            letter-spacing: 0.02em;
            line-height: 1.2;
            color: #ffffff;
        }

        .album-card-sub {
            font-size: 0.82rem;
            font-weight: 300;
            color: rgba(255, 255, 255, 0.8);
            margin-top: 0.35rem;
            opacity: 0.85;
        }

        /* ==========================================================================
           DEDICATED ALBUM PAGE VIEW
           ========================================================================== */
        .album-page-header {
            padding-top: 2.25rem;
            padding-bottom: 3rem;
        }

        .top-nav-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 1.5rem;
            margin-bottom: 2.5rem;
            border-bottom: 1px solid var(--border-light);
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-primary);
            padding: 0.65rem 1rem 0.65rem 0;
            transition: color var(--transition-fast), transform var(--transition-fast);
        }

        .back-btn:hover {
            color: var(--text-secondary);
            transform: translateX(-3px);
        }

        .album-series-label {
            font-size: 0.72rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .album-hero-info {
            max-width: 720px;
        }

        .album-page-title {
            font-family: var(--font-serif);
            font-size: clamp(2.25rem, 5vw, 3.75rem);
            font-weight: 400;
            line-height: 1.12;
            color: var(--text-primary);
            margin-bottom: 1rem;
        }

        .album-page-desc {
            font-size: 1.02rem;
            font-weight: 300;
            color: var(--text-secondary);
            line-height: 1.75;
            margin-bottom: 1.5rem;
        }

        .album-page-meta-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.85rem;
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .meta-dot {
            color: var(--border-light);
        }

        /* Album Photo Gallery Grid */
        .photo-gallery-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.75rem;
        }

        @media (min-width: 768px) {
            .photo-gallery-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2.25rem;
            }
        }

        .photo-item {
            background-color: var(--bg-secondary);
            border-radius: var(--radius-md);
            overflow: hidden;
            border: 1px solid var(--border-light);
            cursor: zoom-in;
            transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
        }

        .photo-item.wide {
            grid-column: 1 / -1;
        }

        .photo-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
        }

        .photo-frame {
            width: 100%;
            aspect-ratio: 4 / 3;
            overflow: hidden;
            background-color: var(--bg-card);
        }

        .photo-item.wide .photo-frame {
            aspect-ratio: 16 / 9;
        }

        @media (max-width: 640px) {
            .photo-item.wide .photo-frame {
                aspect-ratio: 4 / 3;
            }
        }

        .photo-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
        }

        .photo-item:hover .photo-frame img {
            transform: scale(1.03);
        }

        .photo-caption-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.95rem 1.25rem;
            background-color: var(--bg-primary);
            border-top: 1px solid var(--border-light);
        }

        .photo-title {
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .photo-specs {
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            text-align: right;
        }

        /* ==========================================================================
           PROMINENT BOTTOM HEADER (FOOTER NAVIGATION BAR ON EVERY PAGE)
           ========================================================================== */
        .bottom-header {
            background-color: var(--bg-dark);
            color: var(--text-inverse);
            border-top: 1px solid var(--border-dark);
            margin-top: auto;
            width: 100%;
        }

        .bottom-header-inner {
            max-width: 1240px;
            margin: 0 auto;
            padding: 3.5rem 1.5rem 2.75rem;
        }

        @media (min-width: 640px) {
            .bottom-header-inner {
                padding: 4.25rem 2.5rem 3rem;
            }
        }

        .bottom-header-top {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2.5rem;
            padding-bottom: 2.75rem;
            border-bottom: 1px solid var(--border-dark);
        }

        @media (min-width: 768px) {
            .bottom-header-top {
                grid-template-columns: 1.2fr 1.5fr 1fr;
                gap: 3rem;
            }
        }

        .bottom-brand-title {
            font-family: var(--font-serif);
            font-size: 1.65rem;
            letter-spacing: 0.08em;
            color: var(--text-inverse);
            display: inline-block;
            margin-bottom: 0.65rem;
            text-align: left;
            transition: opacity var(--transition-fast);
        }

        .bottom-brand-title:hover {
            opacity: 0.8;
        }

        .bottom-brand-tagline {
            font-size: 0.85rem;
            font-weight: 300;
            color: var(--text-inverse-muted);
            line-height: 1.6;
            max-width: 280px;
        }

        .bottom-nav-heading {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--text-inverse-muted);
            margin-bottom: 1.1rem;
        }

        .bottom-album-links {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.65rem 1.25rem;
        }

        .bottom-link {
            font-size: 0.84rem;
            color: var(--text-inverse);
            text-align: left;
            padding: 0.2rem 0;
            opacity: 0.82;
            transition: opacity var(--transition-fast), transform var(--transition-fast);
        }

        .bottom-link:hover {
            opacity: 1;
            transform: translateX(3px);
        }

        .bottom-link.active-album-link {
            opacity: 1;
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .bottom-contact-list {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .bottom-header-bar {
            padding-top: 1.75rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            font-size: 0.75rem;
            color: var(--text-inverse-muted);
        }

        @media (min-width: 640px) {
            .bottom-header-bar {
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
            }
        }

        .bottom-quick-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-size: 0.7rem;
        }

        .bottom-quick-actions button {
            color: var(--text-inverse);
            opacity: 0.85;
            transition: opacity var(--transition-fast);
        }

        .bottom-quick-actions button:hover {
            opacity: 1;
        }

        /* ==========================================================================
           FULL-SCREEN LIGHTBOX VIEWER
           ========================================================================== */
        .lightbox {
            position: fixed;
            inset: 0;
            z-index: 1000;
            background-color: rgba(12, 11, 10, 0.96);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.25rem;
            opacity: 0;
            pointer-events: none;
            transition: opacity 250ms ease;
        }

        @media (min-width: 640px) {
            .lightbox {
                padding: 2rem;
            }
        }

        .lightbox.open {
            opacity: 1;
            pointer-events: auto;
        }

        .lightbox-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 10;
        }

        .lightbox-counter {
            font-size: 0.75rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--text-inverse-muted);
        }

        .lightbox-close {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background var(--transition-fast);
        }

        .lightbox-close:hover {
            background: rgba(255, 255, 255, 0.18);
        }

        .lightbox-stage {
            position: relative;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 1rem 0;
            overflow: hidden;
            user-select: none;
        }

        .lightbox-img {
            max-height: 72vh;
            max-width: calc(100vw - 6.5rem);
            width: auto;
            height: auto;
            object-fit: contain;
            border-radius: var(--radius-sm);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
            transition: opacity 160ms ease;
        }

        @media (max-width: 640px) {
            .lightbox-img {
                max-width: calc(100vw - 2.5rem);
                max-height: 65vh;
            }
        }

        .lightbox-nav {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background var(--transition-fast), transform var(--transition-fast);
            z-index: 10;
        }

        .lightbox-nav:hover {
            background: rgba(255, 255, 255, 0.22);
        }

        .lightbox-prev {
            left: 0.25rem;
        }

        .lightbox-next {
            right: 0.25rem;
        }

        .lightbox-bottom {
            text-align: center;
            z-index: 10;
        }

        .lightbox-caption-title {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            color: #ffffff;
            margin-bottom: 0.25rem;
        }

        .lightbox-caption-meta {
            font-size: 0.72rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--text-inverse-muted);
        }

        /* ==========================================================================
           NON-INTRUSIVE TOAST MESSAGE
           ========================================================================== */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 1100;
            background-color: var(--bg-dark);
            color: var(--text-inverse);
            border: 1px solid var(--border-dark);
            padding: 0.85rem 1.25rem;
            border-radius: var(--radius-md);
            font-size: 0.75rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
            transform: translateY(120%);
            opacity: 0;
            transition: transform 260ms ease, opacity 260ms ease;
            pointer-events: none;
        }

        .toast.visible {
            transform: translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body>

    <!-- ======================================================================
         PAGE 1: LANDING PAGE VIEW
         ====================================================================== -->
    <div id="landing-page" class="page-view">
        <header class="landing-header">
            <p class="eyebrow">Curated Photography Index &bull; 2022–2026</p>
            <h1 class="main-title">VISUAL ARCHIVE</h1>
            <p class="main-subtitle">
                A quiet study of architectural geometry, northern silence, and human presence across six photographic monographs.
            </p>
            <div class="header-divider"></div>
        </header>

        <main class="main-content">
            <div class="container">
                <section id="albums-grid" class="albums-grid" aria-label="Photography Albums">
                    <!-- Square (1:1) Album Cards rendered by JS -->
                </section>
            </div>
        </main>

        <!-- Prominent Bottom Header on Landing Page -->
        <div id="landing-bottom-header"></div>
    </div>

    <!-- ======================================================================
         PAGE 2: DEDICATED ALBUM PAGE VIEW
         ====================================================================== -->
    <div id="album-page" class="page-view hidden">
        <div class="container">
            <header class="album-page-header">
                <nav class="top-nav-bar" aria-label="Album Top Navigation">
                    <button type="button" class="back-btn" onclick="showLandingPage()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        <span>Back to Albums</span>
                    </button>
                    <span id="album-series-tag" class="album-series-label">Series 01</span>
                </nav>

                <div class="album-hero-info">
                    <h1 id="album-title" class="album-page-title">Album Title</h1>
                    <p id="album-description" class="album-page-desc">Album description.</p>
                    <div class="album-page-meta-row">
                        <span id="album-location">Location</span>
                        <span class="meta-dot">&bull;</span>
                        <span id="album-year">Year</span>
                        <span class="meta-dot">&bull;</span>
                        <span id="album-count">0 Plates</span>
                    </div>
                </div>
            </header>
        </div>

        <main class="main-content">
            <div class="container">
                <section id="album-gallery" class="photo-gallery-grid" aria-label="Album Photographs">
                    <!-- Album Photographs rendered by JS -->
                </section>
            </div>
        </main>

        <!-- Prominent Bottom Header on Every Album Page -->
        <div id="album-bottom-header"></div>
    </div>

    <!-- ======================================================================
         FULL-SCREEN LIGHTBOX VIEWER
         ====================================================================== -->
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Image Lightbox Viewer">
        <div class="lightbox-top">
            <div class="lightbox-counter">
                <span id="lb-counter">1 / 4</span>
                <span style="margin: 0 0.6rem; opacity: 0.4;">|</span>
                <span id="lb-album-title">Album</span>
            </div>
            <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Close viewer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="lightbox-stage">
            <button type="button" class="lightbox-nav lightbox-prev" onclick="prevLightboxPhoto(event)" aria-label="Previous image">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>

            <img id="lb-image" class="lightbox-img" src="" alt="">

            <button type="button" class="lightbox-nav lightbox-next" onclick="nextLightboxPhoto(event)" aria-label="Next image">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>

        <div class="lightbox-bottom">
            <p id="lb-title" class="lightbox-caption-title">Plate Title</p>
            <p id="lb-specs" class="lightbox-caption-meta">Camera Details</p>
        </div>
    </div>

    <!-- Toast Notification -->
